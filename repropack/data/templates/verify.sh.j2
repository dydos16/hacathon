#!/bin/sh
# Проверка пакета в чистом виртуальном окружении (создано repro-packer).
# Запуск: sh verify.sh     Другой интерпретатор: PYTHON=/путь/к/python sh verify.sh
cd "$(dirname "$0")" || exit 1
# Без PYTHON берём нужную версию, а если её нет — ближайшую новее: на macOS python3 — системный 3.9
if [ -z "$PYTHON" ]; then
  for version in {{ python_candidates|join(" ") }}; do
    if command -v "python$version" > /dev/null 2>&1; then PYTHON="python$version"; break; fi
  done
fi
PYTHON="${PYTHON:-python3}"
LOG=verify_log.txt
VPY=.repro-venv/bin/python
log() { echo "$1" | tee -a "$LOG"; }

: > "$LOG"
log "== Проверка: $(date)"
log "Ожидается Python {{ python_version }}, найден: $("$PYTHON" --version 2>&1)"
FOUND=$("$PYTHON" -c 'import sys; print("%d.%d" % sys.version_info[:2])' 2>/dev/null)
if [ "$FOUND" != "{{ python_version }}" ]; then
  log "ВНИМАНИЕ: нужен Python {{ python_version }}, а запускается ${FOUND:-неизвестная версия} — результат может отличаться. Другой интерпретатор: PYTHON=python{{ python_version }} sh verify.sh"
fi
rm -rf .repro-venv
"$PYTHON" -m venv .repro-venv >> "$LOG" 2>&1 || { log "ОШИБКА: не удалось создать venv"; exit 1; }

log "-- Установка зависимостей из requirements.txt"
"$VPY" -m pip install --disable-pip-version-check -r requirements.txt >> "$LOG" 2>&1 \
  || { log "РЕЗУЛЬТАТ: ОШИБКА установки зависимостей (подробности в $LOG)"; exit 2; }
"$VPY" -m pip freeze > requirements.lock.txt
log "-- Точные версии сохранены в requirements.lock.txt"

log {{ run_log_sh }}
cd project || exit 1
"../$VPY" {{ run_tail }} > ../run_output.txt 2>&1
code=$?
cd ..
tee -a "$LOG" < run_output.txt
if [ "$code" -eq 0 ]; then
  log "РЕЗУЛЬТАТ: OK (код выхода 0)"
else
  log "РЕЗУЛЬТАТ: ОШИБКА запуска (код выхода $code)"
fi
exit "$code"
