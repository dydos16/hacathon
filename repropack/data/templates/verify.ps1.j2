# Проверка пакета в чистом виртуальном окружении (создано repro-packer).
# Запуск: powershell -ExecutionPolicy Bypass -File verify.ps1
Set-Location $PSScriptRoot
$Py = if ($env:PYTHON) { $env:PYTHON } else { "python" }
$Log = Join-Path $PSScriptRoot "verify_log.txt"
$VPy = Join-Path $PSScriptRoot ".repro-venv\Scripts\python.exe"
function Log($Text) { $Text | Tee-Object -FilePath $Log -Append }

Set-Content $Log ""
Log "== Проверка: $(Get-Date)"
Log "Ожидается Python {{ python_version }}, найден: $(& $Py --version 2>&1)"
$Found = & $Py -c "import sys; print('%d.%d' % sys.version_info[:2])" 2>$null
if ("$Found" -ne '{{ python_version }}') {
  $Shown = if ($Found) { "$Found" } else { "неизвестная версия" }
  Log "ВНИМАНИЕ: нужен Python {{ python_version }}, а запускается $Shown — результат может отличаться. Другой интерпретатор: задайте путь к нему в переменной окружения PYTHON"
}
if (Test-Path .repro-venv) { Remove-Item -Recurse -Force .repro-venv }
& $Py -m venv .repro-venv *>> $Log
if ($LASTEXITCODE -or -not (Test-Path $VPy)) { Log "ОШИБКА: не удалось создать venv"; exit 1 }

Log "-- Установка зависимостей из requirements.txt"
& $VPy -m pip install --disable-pip-version-check -r requirements.txt *>> $Log
if ($LASTEXITCODE) { Log "РЕЗУЛЬТАТ: ОШИБКА установки зависимостей (подробности в $Log)"; exit 2 }
& $VPy -m pip freeze | Set-Content requirements.lock.txt
Log "-- Точные версии сохранены в requirements.lock.txt"

Log {{ run_log_ps }}
Push-Location project
& $VPy {{ run_tail_ps }} *>&1 | Tee-Object -FilePath $Log -Append
$Code = $LASTEXITCODE
Pop-Location
if ($Code -eq 0) { Log "РЕЗУЛЬТАТ: OK (код выхода 0)" } else { Log "РЕЗУЛЬТАТ: ОШИБКА запуска (код выхода $Code)" }
exit $Code
