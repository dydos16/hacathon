# Проверка пакета в чистом виртуальном окружении (создано repro-packer).
# Запуск: powershell -ExecutionPolicy Bypass -File verify.ps1
Set-Location $PSScriptRoot
# Windows PowerShell 5.1 пишет файлы в UTF-16/ANSI, а Python выводит в канал в cp1252 (кириллица падает).
# Всё переводим на UTF-8: лог читается в любом редакторе, а вывод на русском не ломает запуск.
$env:PYTHONUTF8 = "1"
$Utf8 = New-Object System.Text.UTF8Encoding $false
try { [Console]::OutputEncoding = $Utf8 } catch { }
# Без PYTHON берём нужную версию через лаунчер py, а если её нет — ближайшую новее; иначе python из PATH
$Py = $env:PYTHON
if (-not $Py -and (Get-Command py -ErrorAction SilentlyContinue)) {
  foreach ($Version in @({% for v in python_candidates %}'{{ v }}'{{ ", " if not loop.last }}{% endfor %})) {
    $Exe = & py "-$Version" -c "import sys; print(sys.executable)" 2>$null
    if ($LASTEXITCODE -eq 0 -and $Exe) { $Py = "$Exe".Trim(); break }
  }
}
if (-not $Py) { $Py = "python" }
$Log = Join-Path $PSScriptRoot "verify_log.txt"
$VPy = Join-Path $PSScriptRoot ".repro-venv\Scripts\python.exe"
function Append($Text) { [System.IO.File]::AppendAllText($Log, "$Text`r`n", $Utf8) }
function Log($Text) { Write-Output $Text; Append $Text }

[System.IO.File]::WriteAllText($Log, "", $Utf8)
Log "== Проверка: $(Get-Date)"
Log "Ожидается Python {{ python_version }}, найден: $(& $Py --version 2>&1)"
$Found = & $Py -c "import sys; print('%d.%d' % sys.version_info[:2])" 2>$null
if ("$Found" -ne '{{ python_version }}') {
  $Shown = if ($Found) { "$Found" } else { "неизвестная версия" }
  Log "ВНИМАНИЕ: нужен Python {{ python_version }}, а запускается $Shown — результат может отличаться. Другой интерпретатор: задайте путь к нему в переменной окружения PYTHON"
}
if (Test-Path .repro-venv) { Remove-Item -Recurse -Force .repro-venv }
& $Py -m venv .repro-venv 2>&1 | ForEach-Object { Append "$_" }
if ($LASTEXITCODE -or -not (Test-Path $VPy)) { Log "ОШИБКА: не удалось создать venv"; exit 1 }

Log "-- Установка зависимостей из requirements.txt"
& $VPy -m pip install --disable-pip-version-check -r requirements.txt 2>&1 | ForEach-Object { Append "$_" }
if ($LASTEXITCODE) { Log "РЕЗУЛЬТАТ: ОШИБКА установки зависимостей (подробности в $Log)"; exit 2 }
# Пустой вывод (у проекта нет внешних пакетов) Set-Content не превращает в файл — пишем сами, как verify.sh
$Frozen = @(& $VPy -m pip freeze)
[System.IO.File]::WriteAllLines((Join-Path $PSScriptRoot "requirements.lock.txt"), [string[]]$Frozen, $Utf8)
Log "-- Точные версии сохранены в requirements.lock.txt"

Log {{ run_log_ps }}
Push-Location project
& $VPy {{ run_tail_ps }} 2>&1 | ForEach-Object { Log "$_" }
$Code = $LASTEXITCODE
Pop-Location
if ($Code -eq 0) { Log "РЕЗУЛЬТАТ: OK (код выхода 0)" } else { Log "РЕЗУЛЬТАТ: ОШИБКА запуска (код выхода $Code)" }
exit $Code
