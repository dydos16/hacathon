# Шаблон, созданный repro-packer. Проверьте версию Python и системные пакеты.
FROM python:{{ python_version }}-slim
WORKDIR /app
{% if system_packages %}# Системные библиотеки по справочнику repro-packer (в slim-образе их нет):
{% for package, apt in system_packages %}#   {{ package }}: {{ apt }}
{% endfor %}RUN apt-get update && apt-get install -y --no-install-recommends {{ system_apt }} \
 && rm -rf /var/lib/apt/lists/*
{% endif %}COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
# Проект запускается не от root: пакеты уже поставлены, а в /app код может писать свои результаты
RUN useradd --create-home repro && chown repro /app
COPY --chown=repro:repro project/ .
USER repro
CMD {{ cmd_json }}
